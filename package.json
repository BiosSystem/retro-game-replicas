{
  "name": "biossystem-neon-arcade",
  "private": true,
  "version": "2.1.0",
  "description": "A self-contained procedural arcade platform with 26 games and a generated Meta-Arcade Hall.",
  "author": "BiosSystem Open Source Community",
  "license": "MIT",
  "repository": "https://github.com/BiosSystem/retro-game-replicas",
  "homepage": "https://github.com/BiosSystem/retro-game-replicas#readme",
  "bugs": "https://github.com/BiosSystem/retro-game-replicas/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/**\"",
    "test:regression": "playwright test",
    "test:cross-browser": "playwright test --config playwright.smoke.config.ts",
    "benchmark": "vitest bench --run",
    "baseline": "npm run build && node scripts/performance-baseline.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "phaser": "^4.1.0"
  }
}
